name: Optimize Images

on:
  push:
    branches-ignore:
      - main
    paths:
      - "**/*.jpg"
      - "**/*.jpeg"
      - "**/*.png"

permissions:
  contents: write

jobs:
  optimize-images:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Install Sharp
        run: npm install sharp

      - name: Optimize images
        run: |
          node <<'EOF'
          const sharp = require("sharp");
          const fs = require("fs");
          const path = require("path");

          const MAX_WIDTH = 600;
          const MAX_SIZE = 200 * 1024; // 200 KB

          async function optimizeImage(input) {
            const ext = path.extname(input);
            const output = input.slice(0, -ext.length) + ".webp";

            const metadata = await sharp(input).metadata();

            let width = Math.min(metadata.width, MAX_WIDTH);
            let quality = 90;
            let buffer;

            // First try to achieve <= 200 KB using quality only.
            while (quality >= 60) {
              buffer = await sharp(input)
                .resize({
                  width,
                  withoutEnlargement: true
                })
                .webp({
                  quality,
                  effort: 6
                })
                .toBuffer();

              if (buffer.length <= MAX_SIZE) {
                break;
              }

              quality -= 5;
            }

            // If quality alone isn't enough, reduce dimensions
            // while preserving the aspect ratio.
            while (buffer.length > MAX_SIZE && width > 300) {
              width = Math.floor(width * 0.9);

              buffer = await sharp(input)
                .resize({
                  width,
                  withoutEnlargement: true
                })
                .webp({
                  quality: Math.max(quality, 60),
                  effort: 6
                })
                .toBuffer();
            }

            // Final fallback for unusually large/complex images.
            while (buffer.length > MAX_SIZE && quality > 40) {
              quality -= 5;

              buffer = await sharp(input)
                .resize({
                  width,
                  withoutEnlargement: true
                })
                .webp({
                  quality,
                  effort: 6
                })
                .toBuffer();
            }

            fs.writeFileSync(output, buffer);

            const sizeKB = (buffer.length / 1024).toFixed(1);

            console.log(
              `${input} -> ${output} | ${width}px | quality ${quality} | ${sizeKB} KB`
            );

            // Remove original image.
            fs.unlinkSync(input);
          }

          async function main() {
            const files = [];

            function scan(directory) {
              for (const entry of fs.readdirSync(directory, {
                withFileTypes: true
              })) {
                if (
                  entry.name === ".git" ||
                  entry.name === "node_modules"
                ) {
                  continue;
                }

                const fullPath = path.join(directory, entry.name);

                if (entry.isDirectory()) {
                  scan(fullPath);
                } else if (
                  /\.(jpg|jpeg|png)$/i.test(entry.name)
                ) {
                  files.push(fullPath);
                }
              }
            }

            scan(".");

            if (files.length === 0) {
              console.log("No images to optimize.");
              return;
            }

            for (const file of files) {
              await optimizeImage(file);
            }
          }

          main().catch(error => {
            console.error(error);
            process.exit(1);
          });
          EOF

      - name: Commit optimized images
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add -A

          if git diff --cached --quiet; then
            echo "No changes to commit."
            exit 0
          fi

          git commit -m "chore: optimize images for mobile"
          git push
